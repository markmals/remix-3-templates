{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "jsxImportSource": "remix/ui",
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "lib": ["DOM", "DOM.Iterable", "ESNext", "WebWorker"],
        "types": ["vite/client", "@pitlane/dev/assets"]
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["dist"]
}
