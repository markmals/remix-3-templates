{
    "private": true,
    "type": "module",
    "imports": {
        "#/*": "./app/*"
    },
    "scripts": {
        "predev": "node --run db:migrate",
        "dev": "node --env-file=.env --watch --import remix/node-tsx server.ts",
        "start": "NODE_ENV=production node --env-file=.env --import remix/node-tsx server.ts",
        "fmt": "oxfmt",
        "lint": "oxlint --fix",
        "check": "oxfmt --check; oxlint; tsc",
        "check:fix": "oxfmt && oxlint --fix && tsc",
        "db:migrate": "node --env-file=.env db/migrate.ts",
        "db:reset": "node --env-file=.env db/reset.ts",
        "typecheck": "tsc"
    },
    "dependencies": {
        "remix": "3.0.0-rc.1"
    },
    "devDependencies": {
        "@types/node": "^25.6.0",
        "eslint-plugin-perfectionist": "^5.8.0",
        "eslint-plugin-prefer-let": "^4.2.2",
        "oxfmt": "^0.47.0",
        "oxlint": "^1.62.0",
        "oxlint-tsgolint": "^0.23.0",
        "typescript": "rc"
    },
    "engines": {
        "node": ">=24.3.0"
    },
    "packageManager": "pnpm@10.33.0"
}
